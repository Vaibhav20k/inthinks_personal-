{
  "name": "inthinks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm test && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "cf:dev": "wrangler dev",
    "db:create": "wrangler d1 create inthinks-submissions",
    "db:migrate": "wrangler d1 migrations apply inthinks-submissions --remote",
    "db:migrate:local": "wrangler d1 migrations apply inthinks-submissions --local",
    "r2:create": "wrangler r2 bucket create inthinks-evidence",
    "dev:worker": "wrangler dev -c wrangler.local.toml",
    "dev:db": "wrangler d1 migrations apply inthinks-submissions --local -c wrangler.local.toml",
    "test": "esbuild tests/match-rules.test.ts --bundle --platform=node --format=esm --outfile=.test-build/match-rules.mjs && node .test-build/match-rules.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.124.0"
  },
  "engines": {
    "node": ">=20"
  }
}
